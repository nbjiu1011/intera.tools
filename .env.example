# Copy to .env.local for local development. In production (Cloudflare Workers Builds)
# set the NEXT_PUBLIC_* values as *build* variables: they are baked into the static
# pages by `next build`, so change them → rebuild.

# Public site URL, used for canonical URLs, hreflang, sitemap and Open Graph.
NEXT_PUBLIC_SITE_URL=https://intera.tools

# Contact address shown on the contact, privacy and terms pages.
NEXT_PUBLIC_CONTACT_EMAIL=support@intera.tools

# Google AdSense publisher id (ca-pub-XXXXXXXXXXXXXXXX). Leave empty to show
# reserved placeholders in development and nothing in production.
NEXT_PUBLIC_ADSENSE_CLIENT=
# Ad unit slot ids per placement (tool pages: below the workspace; home/catalog: between sections).
NEXT_PUBLIC_ADSENSE_SLOT_TOOL=
NEXT_PUBLIC_ADSENSE_SLOT_HOME=

# Search engine verification tokens (content value of the meta tag only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_NAVER_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=

# Contact form → Slack or Discord incoming webhook. In production this is a Worker
# *secret* (dashboard → Workers → intera-tools → Settings → Variables and Secrets),
# for `wrangler dev` put it in .dev.vars. Under `next dev` without it, messages go
# to data/contact.ndjson.
CONTACT_WEBHOOK_URL=

# `next dev` only: where /api/events appends usage events (default ./data/events.ndjson).
# In production events go to Workers Logs.
EVENTS_LOG=
