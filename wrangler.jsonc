// Cloudflare Workers deployment: `npm run deploy`, or Workers Builds connected to GitHub
// (build command `npm run build`, deploy command `npx wrangler deploy`).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "intera-tools",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    // Static export from `next build`. Files are served without running the Worker.
    "directory": "./out",
    "binding": "ASSETS",
    // /en/merge-pdf → out/en/merge-pdf.html
    "html_handling": "auto-trailing-slash",
    // Requests with no matching file go to worker/index.ts (language redirect, 404).
    "not_found_handling": "none",
    "run_worker_first": ["/api/*"]
  },
  // Usage events and contact errors appear in dashboard → Workers → intera-tools → Logs.
  "observability": { "enabled": true }
}
